# ═══════════════════════════════════════════════════════════════════════
# Configuration pour déploiement sur GitHub Pages
# ═══════════════════════════════════════════════════════════════════════

# 1. APPLICATION SETTINGS
# ───────────────────────────────────────────────────────────────────────
APP_NAME="Portfolio"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# Pour production avec domaine personnalisé (optionnel):
# APP_URL=https://portfolio.com

# Générer une clé: php artisan key:generate
APP_KEY=base64:VOTRE_CLE_ICI_GENEREE_PAR_ARTISAN

# 2. DATABASE - SQLite pour GitHub Pages
# ───────────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=portfolio
# DB_USERNAME=root
# DB_PASSWORD=

# 3. CACHE & SESSION
# ───────────────────────────────────────────────────────────────────────
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# 4. QUEUE & MAIL
# ───────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@portfolio.com"

# 5. CLOUDINARY (Optionnel - pour les images)
# ───────────────────────────────────────────────────────────────────────
# Retirez les # si vous utilisez Cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# 6. REDIS (Optionnel - si vous utilisez)
# ───────────────────────────────────────────────────────────────────────
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# 7. GITHUB PAGES SPECIFIC
# ───────────────────────────────────────────────────────────────────────
# Définir pour la génération statique
GITHUB_PAGES_URL=https://username.github.io/repository-name
STATIC_OUTPUT_DIR=dist

# 8. LOGGING
# ───────────────────────────────────────────────────────────────────────
LOG_CHANNEL=single
LOG_LEVEL=debug

# ═══════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS D'UTILISATION:
#
# 1. Copier ce fichier à la racine du projet:
#    cp .env.example.github-pages .env
#
# 2. Générer la clé APP_KEY:
#    php artisan key:generate
#
# 3. Pour SQLite, créer la base:
#    mkdir -p database
#    touch database/portfolio.sqlite
#    php artisan migrate --database=sqlite
#
# 4. Tester la génération locale:
#    npm run build:static
#
# 5. Vérifier le dossier dist/:
#    ls dist/
#
# ═══════════════════════════════════════════════════════════════════════
